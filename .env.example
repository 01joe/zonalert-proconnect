# ═══════════════════════════════════════════════════════════════════
# ZonAlert Backend — Exemple de configuration
# Copier ce fichier : cp .env.example .env
# Puis renseigner toutes les valeurs
# ═══════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=ZonAlert Backend

# ── Base de données PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD="290897"
DB_NAME=zonalert
DB_SYNC=true
DB_LOGGING=false

# ── JWT ─────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=GENERER_UNE_CLE_ALEATOIRE
JWT_REFRESH_SECRET=GENERER_UNE_AUTRE_CLE
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Rate Limiting ────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Firebase Admin SDK (optionnel) ──────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
